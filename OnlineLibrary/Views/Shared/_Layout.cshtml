
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OnlineLibrary</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="" crossorigin="anonymous">

    <environment include="Development">
        <link rel="stylesheet" href="~/css/site.css" />
    </environment>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css">

    @await RenderSectionAsync("Styles", required: false)

</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(90deg,var(--brand-primary), var(--brand-accent));">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">OnlineLibrary</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto">

                     @if (User?.Identity?.IsAuthenticated ?? false)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle text-light fw-bold" href="#" id="manageDropdown"
                                       role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-tools"></i> Admin
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-dark border-0">
                                        <li>
                                            <a class="dropdown-item" asp-area="Admin" asp-controller="UserManagement" asp-action="Index">
                                                <i class="bi bi-building"></i> Manage Users
                                            </a>
                                        </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="BookManagement" asp-action="Manage">
                                            <i class="bi bi-ticket-detailed"></i> Manage Books
                                        </a>
                                    </li>
                                        <li>
                                            <a class="dropdown-item" asp-area="Admin" asp-controller="AuthorManagement" asp-action="Manage">
                                                <i class="bi bi-camera-reels"></i> Manage Authors
                                            </a>
                                        </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="Admin" asp-controller="PublisherManagement" asp-action="Manage">
                                            <i class="bi bi-camera-reels"></i> Manage Publishers
                                        </a>
                                    </li>
                                      
                                    </ul>
                                </li>
                            }

                    @*     @if (User.IsInRole("User"))
                        {
                            <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Books/All">Books</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Author/All">Authors</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Publisher/All">Publishers</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Books/Favorites">Favorites</a></li>
                        } *@
                    }

                  @*   @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link" href="/Books/Favorites">Favorites</a></li>
                    } *@
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Books/All">Books</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Author/All">Authors</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Publisher/All">Publishers</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Books/Favorites">Favorites</a></li>

                    <li class="nav-item"><a class="nav-link" href="/Home/Privacy">Privacy</a></li>
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>

    <header class="page-header-hero mb-4">
        <div class="container">
            <h1 class="display-6 text-dark">@ViewData["Title"]</h1>
            <p class="text-muted small">Welcome to OnlineLibrary — discover and manage your books with style.</p>
        </div>
    </header>

    <main role="main" class="container">
        <div class="row">
            <div class="col-12">
                @RenderBody()
            </div>
        </div>
    </main>

    <footer class="bg-white border-top mt-5 py-3">
        <div class="container d-flex justify-content-between small">
            <span class="text-muted">© @DateTime.Now.Year OnlineLibrary</span>
            <span class="text-muted"><a class="link-secondary" href="/Home/Privacy">Privacy</a></span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" integrity="" crossorigin="anonymous"></script>

    @RenderSection("Scripts", required: false)
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
   @*  <script src="~/js/adminManagement.js" asp-append-version="true"></script> *@
</body>
</html>
