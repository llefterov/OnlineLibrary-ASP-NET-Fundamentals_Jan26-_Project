@{
    ViewData["Title"] = "404 Not Found";
}

<section class="not-found-page d-flex align-items-center justify-content-center py-5">
    <div class="card not-found-card border-0 shadow-lg">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="not-found-icon mb-3">
                <i class="bi bi-book"></i>
            </div>

            <p class="text-uppercase text-warning fw-semibold mb-2">Error 404</p>
            <h1 class="h3 fw-bold mb-3">Page Not Found</h1>

            <p class="text-muted mb-4">
                The page you’re looking for doesn’t exist or may have been moved.
                Let’s get you back to something worth watching.
            </p>

            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
                <a asp-controller="Home" asp-action="Index" class="btn btn-warning px-4">
                    <i class="bi bi-house-door me-1"></i> Back to Home
                </a>
                <a asp-controller="Books" asp-action="All" class="btn btn-outline-dark px-4">
                    <i class="bi bi-book me-1"></i> Browse Books
                </a>
            </div>
        </div>
    </div>
</section>

@section Styles {
    <style>
        .not-found-page {
            min-height: calc(100vh - 220px);
        }

        .not-found-card {
            max-width: 640px;
            width: 100%;
            border-radius: 1rem;
            background: linear-gradient(180deg, #ffffff 0%, #f8f9fa 100%);
        }

        .not-found-icon {
            font-size: 3rem;
            color: #ffc107;
            line-height: 1;
        }
    </style>
}

