@using OnlineLibrary.Web.ViewModels.Author
@model AuthorDeleteViewModel

@{
    ViewData["Title"] = "Confirm Delete Author";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width:800px;">
        <div class="card-body">
            <h2 class="card-title text-danger mb-3">@ViewData["Title"]</h2>

            <p>Are you sure you want to delete the following author?</p>
            @* show model-level errors added by the controller *@
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

            <dl class="row">
                <dt class="col-sm-3">Full name</dt>
                <dd class="col-sm-9">@Model.FullName</dd>

                <dt class="col-sm-3">Author id</dt>
                <dd class="col-sm-9">@Model.Id</dd>
            </dl>

            <h5 class="mt-3">Books by this author</h5>
            @if (Model.BooksAuthors == null || !Model.BooksAuthors.Any())
            {
                <div class="alert alert-info">This author has no associated books.</div>
            }
            else
            {
                <ul class="list-group mb-3">
                    @foreach (var ba in Model.BooksAuthors.OrderBy(ba => ba.Book?.Title))
                    {
                        if (ba.Book == null) { continue; }
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@ba.Book.Title</span>
                            <small class="text-muted">@ba.Book.DateAdded.ToString("yyyy-MM-dd")</small>
                        </li>
                    }
                </ul>
            }

            <form asp-controller="Author" asp-action="Delete" method="post" class="needs-validation" novalidate="novalidate">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">
                    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                        <button type="submit" class="btn btn-danger">Confirm Delete</button>
                    }
                    <a asp-controller="Author" asp-action="All" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>