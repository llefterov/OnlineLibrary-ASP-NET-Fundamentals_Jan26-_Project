@using OnlineLibrary.Web.ViewModels.Author
@model IEnumerable<AuthorAllViewModel>

@{
    ViewData["Title"] = "All Authors";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">@ViewData["Title"]</h1>

        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Manager"))
        {
            <a asp-controller="Author" asp-action="Add" class="btn btn-sm btn-outline-primary">Add New Author</a>
        }
    </div>
</div>

<!-- Search Form -->
<form asp-action="All" method="get" class="mb-4">
    <div class="input-group">
        <input type="text"
               name="searchQuery"
               class="form-control"
               placeholder="Search by title..."
               value="@ViewData["SearchQuery"]" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Author FullName</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (AuthorAllViewModel author in Model)
        {
            <tr>
                <td>@author.FullName</td>
                <td>

                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Author" asp-action="Details" asp-route-id="@author.Id">Details</a>
                        
                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Manager"))
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-controller="Author" asp-action="Edit" asp-route-id="@author.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-controller="Author" asp-action="Delete" asp-route-id="@author.Id">Delete</a>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
