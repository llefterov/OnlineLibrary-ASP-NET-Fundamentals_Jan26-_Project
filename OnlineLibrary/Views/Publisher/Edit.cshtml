@using OnlineLibrary.Web.ViewModels.Publisher
@model PublisherEditViewModel

@{
    ViewData["Title"] = "Edit Publisher";
}

<div class="container py-4">
    <div class="card card-accent shadow-sm mx-auto" style="max-width:720px;">
        <div class="card-body">
            <h2 class="card-title brand-accent mb-3">@ViewData["Title"]</h2>

            <form asp-controller="Publisher" asp-action="Edit" method="post" class="needs-validation" novalidate="novalidate">
                @Html.AntiForgeryToken()

                @* preserve the Id for the POST *@
                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                    {
                        <button type="submit" class="btn btn-primary">Save changes</button>
                    }
                    <a asp-controller="Publisher" asp-action="All" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

}