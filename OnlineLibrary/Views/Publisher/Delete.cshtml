@using OnlineLibrary.Web.ViewModels.Publisher
@model PublisherDeleteViewModel

@{
    ViewData["Title"] = "Confirm Delete Publisher";
}

<div class="container py-4">
    <div class="card shadow-sm mx-auto" style="max-width:800px;">
        <div class="card-body">
            <h2 class="card-title text-danger mb-3">@ViewData["Title"]</h2>

            <p>Are you sure you want to delete the following publisher?</p>

            @* show model-level errors added by the controller *@
            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>


            <dl class="row">
                <dt class="col-sm-3">Full name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Publisher id</dt>
                <dd class="col-sm-9">@Model.Id</dd>
            </dl>

            <h5 class="mt-3">Books by this author</h5>
            @if (Model.Books == null || !Model.Books.Any())
            {
                <div class="alert alert-info">This publisher has no associated books.</div>
            }
            else
            {
                <ul class="list-group mb-3">
                    @foreach (var book in Model.Books.OrderBy(b => b.Title))
                    {
                        if (book == null) { continue; }
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@book.Title</span>
                            <small class="text-muted">@book.DateAdded.ToString("yyyy-MM-dd")</small>
                        </li>
                    }
                </ul>
            }

            <form asp-controller="Publisher" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2">
                   @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Manager"))
                    {
                        <button type="submit" class="btn btn-danger">Confirm Delete</button>
                    }
                    <a asp-controller="Publisher" asp-action="All" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
