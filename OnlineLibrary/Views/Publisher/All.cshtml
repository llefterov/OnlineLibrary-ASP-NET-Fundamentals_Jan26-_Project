@using OnlineLibrary.Web.ViewModels.Publisher
@model IEnumerable<PublisherAllViewModel>

@{
    ViewData["Title"] = "All Publishers";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">@ViewData["Title"]</h1>

        @if (User?.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Publisher" asp-action="Add" class="btn btn-sm btn-outline-primary">Add New Publisher</a>
        }
    </div>

    @if (!Model?.Any() ?? true)
    {
        <div class="alert alert-info">No publishers found.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var publisher in Model)
            {
                <div class="col-sm-6 col-md-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-2">@publisher.Name</h5>

                            <div class="mt-auto d-flex gap-2">
                                <a class="btn btn-sm btn-outline-secondary" asp-controller="Publisher" asp-action="Details" asp-route-id="@publisher.Id">Details</a>

                                @if (User?.Identity?.IsAuthenticated == true)
                                {
                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Publisher" asp-action="Edit" asp-route-id="@publisher.Id">Edit</a>
                                    <a class="btn btn-sm btn-outline-danger" asp-controller="Publisher" asp-action="Delete" asp-route-id="@publisher.Id">Delete</a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>