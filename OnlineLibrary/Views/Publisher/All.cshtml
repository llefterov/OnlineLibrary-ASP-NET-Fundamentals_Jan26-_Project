@using OnlineLibrary.Web.ViewModels.Publisher
@model IEnumerable<PublisherAllViewModel>

    
@{
    ViewData["Title"] = "All Publishers";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">@ViewData["Title"]</h1>

        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Manager"))
        {
            <a asp-controller="Publisher" asp-action="Add" class="btn btn-sm btn-outline-primary">Add New Publisher</a>
        }
    </div>
</div>

<!-- Search Form -->
<form asp-action="All" method="get" class="mb-4">
    <div class="input-group">
        <input type="text"
               name="searchQuery"
               class="form-control"
               placeholder="Search by title..."
               value="@ViewData["SearchQuery"]" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Publisher</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (PublisherAllViewModel publisher in Model)
        {
            <tr>
                <td>@publisher.Name</td>
                <td>
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <a class="btn btn-sm btn-outline-secondary" asp-controller="Publisher" asp-action="Details" asp-route-id="@publisher.Id">Details</a>

                        @if (User.IsInRole("Manager"))
                        {

                            <a class="btn btn-sm btn-outline-primary" asp-controller="Publisher" asp-action="Edit" asp-route-id="@publisher.Id">Edit</a>
                            <a class="btn btn-sm btn-outline-danger" asp-controller="Publisher" asp-action="Delete" asp-route-id="@publisher.Id">Delete</a>
                        }
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination">
        @if ((int)ViewData["CurrentPage"] > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-action="All"
                   asp-route-pageNumber="@((int)ViewData["CurrentPage"] - 1)"
                   asp-route-searchQuery="@ViewData["SearchQuery"]">
                    Previous
                </a>
            </li>
        }

        @for (int i = 1; i <= (int)ViewData["TotalPages"]; i++)
        {
            <li class="page-item @(i == (int)ViewData["CurrentPage"] ? "active" : "")">
                <a class="page-link" asp-action="All"
                   asp-route-pageNumber="@i"
                   asp-route-searchQuery="@ViewData["SearchQuery"]">
                    @i
                </a>
            </li>
        }

        @if ((int)ViewData["CurrentPage"] < (int)ViewData["TotalPages"])
        {
            <li class="page-item">
                <a class="page-link" asp-action="All"
                   asp-route-pageNumber="@((int)ViewData["CurrentPage"] + 1)"
                   asp-route-searchQuery="@ViewData["SearchQuery"]">
                    Next
                </a>
            </li>
        }
    </ul>
</nav>
