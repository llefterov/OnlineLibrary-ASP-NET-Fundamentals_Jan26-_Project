@using OnlineLibrary.Web.ViewModels.Publisher
@model PublisherDetailsViewModel

@{
    ViewData["Title"] = "Publisher Details";
}

<div class="container py-4">
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h4 mb-0">@Model.Name</h1>
            <p class="text-muted small mb-0">Publisher details and books</p>
        </div>

        <div>
            <a class="btn btn-sm btn-outline-secondary" asp-controller="Publisher" asp-action="All">Back to publishers</a>
            <a class="btn btn-sm btn-outline-primary" asp-controller="Publisher" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">Books by @Model.Name</h5>

            @if (Model.Books == null || !Model.Books.Any())
            {
                <div class="alert alert-info mb-0">No books found for this publisher.</div>
            }
            else
            {
                <div class="row g-3">
                    @foreach (var b in Model.Books.OrderBy(b => 
                    b.Title))
                    {
                        var book = b;
                        if (book == null) { continue; }

                        <div class="col-12">
                            <div class="card h-100">
                                <div class="row g-0 align-items-stretch">
                                    <div class="col-md-2 d-none d-md-block">
                                        <img src="@(string.IsNullOrEmpty(book.CoverUrl) ? "/images/placeholder-book.jpg" : book.CoverUrl)"
                                             class="img-fluid rounded-start" alt="@book.Title"
                                             style="object-fit:cover; min-height:120px; max-height:160px; width:100%;" />
                                    </div>

                                    <div class="col-md-10">
                                        <div class="card-body d-flex flex-column">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h5 class="card-title mb-1">@book.Title</h5>
                                                    <p class="card-subtitle mb-2 text-muted small">
                                                        @if (book.Publisher != null)
                                                        {
                                                            @book.Publisher.Name
                                                        }
                                                        else
                                                        {
                                                            <text>Publisher unknown</text>
                                                        }
                                                    </p>
                                                </div>

                                                <div class="text-end">
                                                    <span class="badge bg-primary">@book.Genre.ToString()</span>
                                                    <span class="badge @(book.isRead ? "bg-success" : "bg-secondary") ms-1">
                                                        @(book.isRead ? "Read" : "Not read")
                                                    </span>
                                                </div>
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(book.Description))
                                            {
                                                <p class="mb-2">@book.Description</p>
                                            }

                                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                                <div class="small text-muted">
                                                    <div>Rating: @book.Rating / 5</div>
                                                    <div>Added: @book.DateAdded.ToString("yyyy-MM-dd")</div>
                                                    @if (book.DateRead.HasValue)
                                                    {
                                                        <div>Read: @book.DateRead.Value.ToString("yyyy-MM-dd")</div>
                                                    }
                                                </div>

                                                <div>
                                                    <a class="btn btn-sm btn-outline-secondary me-2" asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">Details</a>
                                                    <a class="btn btn-sm btn-outline-primary" asp-controller="Books" asp-action="Edit" asp-route-id="@book.Id">Edit</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
