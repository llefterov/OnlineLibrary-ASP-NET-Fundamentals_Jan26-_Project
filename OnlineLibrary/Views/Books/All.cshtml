@using OnlineLibrary.Web.ViewModels.Books
@using OnlineLibrary.Web.Infrastructure.Utilities.Contracts
@using static OnlineLibrary.GCommon.ApplicationConstants
@model IEnumerable<BooksAllViewModel>

@inject ISlugGenerator slugGenerator

@{
    ViewData["Title"] = "All Books";
}

<link rel="stylesheet" href="~/css/books-all.css" asp-append-version="true" />

@* <h1 class="h3 mb-0">@ViewData["Title"]</h1>*@
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@ViewData["Title"]</h1>

    @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Manager"))
    {
        <a asp-controller="Books" asp-action="MyBooks" class="btn btn-sm btn-outline-primary">My Books</a>
        <a asp-controller="Books" asp-action="Create" class="btn btn-sm btn-outline-primary">Add New Book</a>
    }
</div>

<!-- Search Form -->

<form method="get" asp-action="All" class="mb-4">
    <div class="row">
        <div class="col">
            <input type="text"
                   name="searchQuery"
                   class="form-control"
                   placeholder="Search by title..."
                   value="@ViewData["SearchQuery"]" />
        </div>
        <div class="col">
            <input type="text"
                   name="publisherFilter"
                   class="form-control"
                   placeholder="Filter by Publisher..."
                   value="@ViewData["PublisherFilter"]" />
        </div>
        <div class="col">
            <input type="text"
                   name="genreFilter"
                   class="form-control"
                   placeholder="Filter by Genre..."
                   value="@ViewData["GenreFilter"]" />
        </div>
        <div class="col">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
    </div>
</form>


@if (!Model?.Any() ?? true)
{
    <div class="alert alert-info">No books found.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Image</th>
                <th>Title</th>
                <th>Publisher</th>
                <th>Genre</th>
                <th>Rating</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (BooksAllViewModel book in Model)
            {
                <tr>
                    <td>
                        <img src="@(string.IsNullOrEmpty(book.CoverUrl) ? DefaultImageUrl : book.CoverUrl)" class="card-cover" alt="@book.Title" style="width: 100px; height: 130px;" />
 
                    </td>
                    <td>@book.Title</td>
                    <td>@book.PublisherName</td>
                    <td>@book.GenreName</td>
                    <td>@book.Rating / 5</td>
                    <td>
                        @if (User?.Identity?.IsAuthenticated == true @*book.AddedByUserName != User?.Identity?.Name*@)
                        {
                            <a asp-route="slugRoute" asp-route-id="@book.Id" asp-route-slug="@slugGenerator.GenerateSlug(book.Title)" class="btn btn-sm btn-info">
                                <i class="fas fa-info-circle"></i> Details
                            </a>

                            @if (!book.IsAddedToUserCollection)
                            {
                                <form asp-controller="Books" asp-action="Save" method="post" class="d-inline">
                                    <input type="hidden" name="id" value="@book.Id" />
                                    <button type="submit" class="btn btn-sm btn-success">Favorites</button>
                                </form>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<nav aria-label="Page navigation" class="mt-4">
    <ul class="pagination">
        @if ((int)ViewData["CurrentPage"] > 1)
        {
            <li class="page-item">
                <a class="page-link" asp-action="All"
                       asp-route-pageNumber="@( (int)ViewData["CurrentPage"] - 1 )"
                       asp-route-searchQuery="@ViewData["SearchQuery"]"
                       asp-route-publisherFilter="@ViewData["PublisherFilter"]"
                       asp-route-genreFilter="@ViewData["GenreFilter"]">
                    Previous
                </a>
            </li>
        }

        @for (int i = 1; i <= (int)ViewData["TotalPages"]; i++)
        {
            <li class="page-item @(i == (int)ViewData["CurrentPage"] ? "active" : "")">
                <a class="page-link" asp-action="All"
                       asp-route-pageNumber="@i"
                       asp-route-searchQuery="@ViewData["SearchQuery"]"
                       asp-route-publisherFilter="@ViewData["PublisherFilter"]"
                       asp-route-genreFilter="@ViewData["GenreFilter"]">
                    @i
                </a>
            </li>
        }

        @if ((int)ViewData["CurrentPage"] < (int)ViewData["TotalPages"])
        {
            <li class="page-item">
                <a class="page-link" asp-action="All"
                       asp-route-pageNumber="@( (int)ViewData["CurrentPage"] + 1 )"
                       asp-route-searchQuery="@ViewData["SearchQuery"]"
                       asp-route-publisherFilter="@ViewData["PublisherFilter"]"
                       asp-route-genreFilter="@ViewData["GenreFilter"]">
                    Next
                </a>
            </li>
        }
    </ul>
</nav>
