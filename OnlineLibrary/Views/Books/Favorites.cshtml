@using OnlineLibrary.Web.ViewModels.Books
@using OnlineLibrary.Web.Infrastructure.Utilities.Contracts
@using static OnlineLibrary.GCommon.ApplicationConstants
@model IEnumerable<BookFavoritesViewModel>
@inject ISlugGenerator slugGenerator

@{
    ViewData["Title"] = "My Favorites";
}
<link rel="stylesheet" href="~/css/books-all.css" asp-append-version="true" />

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">@ViewData["Title"]</h1>
        <a asp-controller="Books" asp-action="All" class="btn btn-sm btn-outline-secondary">Browse all books</a>
    </div>
</div>

<!-- Search Form -->
<form asp-action="Favorites" method="get" class="mb-4">
    <div class="input-group">
        <input type="text"
               name="searchQuery"
               class="form-control"
               placeholder="Search by title..."
               value="@ViewData["SearchQuery"]" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>


@if (!Model?.Any() ?? true)
{
    <div class="alert alert-info">You have no favorite books yet.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Image</th>
                <th>Title</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (BookFavoritesViewModel book in Model)
            {
                <tr>
                    <td>
                        <img src="@(string.IsNullOrEmpty(book.CoverUrl) ? DefaultImageUrl : book.CoverUrl)" class="card-cover" alt="@book.Title" style="width: 100px; height: 130px;" />
                    </td>
                    <td>@book.Title</td>
                    <td>
                        @if (User?.Identity?.IsAuthenticated == true @*book.AddedByUserName != User?.Identity?.Name*@)
                        {
                            <a asp-route="slugRoute" asp-route-id="@book.Id" asp-route-slug="@slugGenerator.GenerateSlug(book.Title)" class="btn btn-sm btn-info">
                                <i class="fas fa-info-circle"></i> Details
                            </a>

                            <form asp-controller="Books" asp-action="Remove" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@book.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash-alt"></i> Remove
                                </button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}