@using OnlineLibrary.Web.ViewModels.Books
@using static OnlineLibrary.GCommon.ApplicationConstants
@model IEnumerable<BookFavoritesViewModel>

@{
    ViewData["Title"] = "My Favorites";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">@ViewData["Title"]</h1>
        <a asp-controller="Books" asp-action="All" class="btn btn-sm btn-outline-secondary">Browse all books</a>
    </div>

    @if (!Model?.Any() ?? true)
    {
        <div class="alert alert-info">You have no favorite books yet.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <img src="@(string.IsNullOrEmpty(item.CoverUrl) ? DefaultImageUrl : item.CoverUrl)"
                             class="card-img-top" alt="@item.Title" style="height:220px; object-fit:cover;" />

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-2 text-truncate">@item.Title</h5>

                            <div class="mt-auto d-flex gap-2 justify-content-center">
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                    <i class="fas fa-info-circle"></i> Details
                                </a>

                                <form asp-controller="Books" asp-action="Remove" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash-alt"></i> Remove
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>