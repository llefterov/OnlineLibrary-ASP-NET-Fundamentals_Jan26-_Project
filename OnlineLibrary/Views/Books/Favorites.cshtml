@using OnlineLibrary.Web.ViewModels.Books
@using OnlineLibrary.Web.Infrastructure.Utilities.Contracts
@using static OnlineLibrary.GCommon.ApplicationConstants
@model IEnumerable<BookFavoritesViewModel>
@inject ISlugGenerator slugGenerator

@{
    ViewData["Title"] = "My Favorites";
}
<link rel="stylesheet" href="~/css/books-all.css" asp-append-version="true" />

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">@ViewData["Title"]</h1>
        <a asp-controller="Books" asp-action="All" class="btn btn-sm btn-outline-secondary">Browse all books</a>
    </div>
</div>

<!-- Search Form -->
<form asp-action="Favorites" method="get" class="mb-4">
    <div class="input-group">
        <input type="text"
               name="searchQuery"
               class="form-control"
               placeholder="Search by title..."
               value="@ViewData["SearchQuery"]" />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>


@if (!Model?.Any() ?? true)
{
    <div class="alert alert-info">You have no favorite books yet.</div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Image</th>
                <th>Title</th>
                <th>Status</th>
                <th>Date Read</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (BookFavoritesViewModel book in Model)
            {
                <tr>
                    <td>
                        <img src="@(string.IsNullOrEmpty(book.CoverUrl) ? DefaultImageUrl : book.CoverUrl)" class="card-cover" alt="@book.Title" style="width: 100px; height: 130px;" />
                    </td>
                    <td>@book.Title</td>
                    <td>
                        <span class="badge @(book.IsRead ? "bg-success" : "bg-primary")">
                            @(book.IsRead ? "Read" : "Not read")
                        </span>
                    </td>
                    <td>
                        @if (!string.IsNullOrEmpty(book.DateRead))
                        {
                            <span>@book.DateRead</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>
                    <td>
                        @if (User?.Identity?.IsAuthenticated == true && (User.IsInRole("Manager") || User.IsInRole("Admin") || User.IsInRole("User")))
                        {
                            <a asp-route="slugRoute" asp-route-id="@book.Id" asp-route-slug="@slugGenerator.GenerateSlug(book.Title)" class="btn btn-sm btn-info">
                                <i class="fas fa-info-circle"></i> Details
                            </a>

                            <button type="button" class="btn btn-sm btn-secondary"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#update-@book.Id"
                                    aria-expanded="false">
                                <i class="fas fa-edit"></i> Update Status
                            </button>

                            <form asp-controller="Books" asp-action="Remove" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@book.Id" />
                                <button type="submit" class="btn btn-sm btn-danger">
                                    <i class="fas fa-trash-alt"></i> Remove
                                </button>
                            </form>
                        }
                    </td>
                </tr>
                @if (User?.Identity?.IsAuthenticated == true && (User.IsInRole("Manager") || User.IsInRole("Admin") || User.IsInRole("User")))
                {
                    <tr class="collapse" id="update-@book.Id">
                        <td colspan="5" class="bg-light">
                            <form asp-controller="Books" asp-action="UpdateReadStatus" method="post" class="d-flex align-items-center gap-3 p-2">
                                <input type="hidden" name="id" value="@book.Id" />
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" name="isRead" value="true"
                                           id="isRead-@book.Id" @(book.IsRead ? "checked" : "") />
                                    <label class="form-check-label" for="isRead-@book.Id">Mark as read</label>
                                </div>
                                <div>
                                    <label for="dateRead-@book.Id" class="form-label mb-0 me-1">Date read:</label>
                                    <input type="date" name="dateRead" id="dateRead-@book.Id"
                                           class="form-control form-control-sm d-inline-block" style="width:160px;"
                                           value="@book.DateRead" />
                                </div>
                                <button type="submit" class="btn btn-sm btn-success">Save</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination">
            @if ((int)ViewData["CurrentPage"] > 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Favorites"
                       asp-route-pageNumber="@((int)ViewData["CurrentPage"] - 1)"
                       asp-route-searchQuery="@ViewData["SearchQuery"]">
                        Previous
                    </a>
                </li>
            }

            @for (int i = 1; i <= (int)ViewData["TotalPages"]; i++)
            {
                <li class="page-item @(i == (int)ViewData["CurrentPage"] ? "active" : "")">
                    <a class="page-link" asp-action="Favorites"
                       asp-route-pageNumber="@i"
                       asp-route-searchQuery="@ViewData["SearchQuery"]">
                        @i
                    </a>
                </li>
            }

            @if ((int)ViewData["CurrentPage"] < (int)ViewData["TotalPages"])
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Favorites"
                       asp-route-pageNumber="@((int)ViewData["CurrentPage"] + 1)"
                       asp-route-searchQuery="@ViewData["SearchQuery"]">
                        Next
                    </a>
                </li>
            }
        </ul>
    </nav>
}