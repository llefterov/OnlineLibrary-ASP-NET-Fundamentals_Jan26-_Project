@using OnlineLibrary.Web.ViewModels.Books
@using static OnlineLibrary.GCommon.ApplicationConstants
@model BookDetailsViewModel

@{
    ViewData["Title"] = "Book Details";
}

<link rel="stylesheet" href="~/css/book-details-actions.css" asp-append-version="true" />

<div class="container py-4">
    <div class="mb-3 d-flex justify-content-between align-items-start">
        <div>
            <h1 class="h4 mb-0">@Model.Title</h1>
            <p class="text-muted small mb-0">@Model.PublisherName</p>
        </div>

        <div class="details-action-bar" role="group" aria-label="Book actions">

            <button type="button" class="btn btn-warning" onclick="history.back()" aria-label="Go back">
                <i class="fas fa-arrow-left me-1" aria-hidden="true"></i> Back
            </button>

            @if (User?.Identity?.IsAuthenticated == true && !Model.IsAddedByUser && !Model.IsAddedToUserCollection)
            {
                <form asp-controller="Books" asp-action="Save" method="post" class="d-inline">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-sm btn-success">
                        <i class="fas fa-heart"></i> Favorites
                    </button>
                </form>
            }
        
            @if (Model.IsAddedByUser && (User?.Identity?.IsAuthenticated == true))
            {
                <a class="btn btn-filled-primary" asp-controller="Books" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
                <a class="btn btn-filled-danger" asp-controller="Books" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
            }
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="row g-0">
        <div class="col-md-3">
            <img src="@(string.IsNullOrEmpty(Model.CoverUrl) ? DefaultImageUrl : Model.CoverUrl)" class="img-fluid w-100 h-100 rounded-start" alt="@Model.Title" style="object-fit:cover; min-height:220px; max-height:320px;" />
        </div>
        <div class="col-md-9">
            <div class="card-body">
                <h5 class="card-title">@Model.Title</h5>
                <div><strong>Author/s:</strong> @Model.AuthorsName</div>
                <p class="mb-2">@Model.Description</p>

                <div class="mb-2">
                    <strong>Genre:</strong> @Model.GenreName

                    @if (Model.IsAddedByUser && (User?.Identity?.IsAuthenticated == true))
                    {
                        <span class="badge @(Model.IsRead ? "bg-success ms-2" : "bg-secondary ms-2")">@(Model.IsRead ? "Read" : "Not read")</span>
                    }
                </div>

                <div class="row">
                    <div class="col-sm-6 small text-muted">
                        <div><strong>Rating:</strong> @Model.Rating / 5</div>
                        <div><strong>Added:</strong> @Model.DateAdded</div>

                        @if (Model.AddedByUserName == null)
                        {
                            <div><strong>Added by:</strong> unknown</div>
                        }
                        else
                        {
                            <div><strong>Added by:</strong> @Model.AddedByUserName</div>
                        }
                    </div>

                    @if (Model.IsAddedByUser && (User?.Identity?.IsAuthenticated == true))
                    {
                        <div class="col-sm-6 text-sm-end small text-muted">
                            @if (!string.IsNullOrEmpty(Model.DateRead))
                            {
                                <div><strong>Read:</strong> @Model.DateRead</div>
                            }
                        </div>
                    }

                    @if (User?.Identity?.IsAuthenticated == true && !Model.IsAddedByUser && Model.IsAddedToUserCollection)
                    {
                        <div class="col-12">
                            <div class="book-status text-start">
                                 <span class="badge bg-success ms-2">Added to favorites </span>
                            </div>
                        </div>
                    }
                </div>
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a class="btn btn-filled-primary" asp-controller="Books" asp-action="MyBooks">MyBooks</a>
                    <a class="btn btn-filled-secondary" asp-controller="Books" asp-action="All">Browse all books</a>
                   </div>
            </div>
        </div>
    </div>
</div>
