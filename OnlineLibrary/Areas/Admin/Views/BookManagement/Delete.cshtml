@using OnlineLibrary.Web.ViewModels.Books
@using static OnlineLibrary.GCommon.ApplicationConstants
@model BookDeleteViewModel

@{
    ViewData["Title"] = "Delete Book";
}

<div class="container py-4">
    <div class="card shadow-lg border-0 bg-dark text-white rounded-3 mx-auto" style="max-width:700px;">
        <div class="card-body p-4">
            <h2 class="card-title text-danger fw-bold mb-3">@ViewData["Title"]</h2>

            <div class="mb-4 text-center">
                <img src="@(string.IsNullOrEmpty(Model.CoverUrl) ? DefaultImageUrl : Model.CoverUrl)"
                     alt="Cover" class="img-thumbnail bg-secondary border-0" style="max-height:200px;" />
                <h4 class="mt-3">@Model.Title</h4>
                @if (!string.IsNullOrEmpty(Model.AddedByUserName))
                {
                    <p class="text-muted small">Added by: @Model.AddedByUserName</p>
                }
            </div>

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                Are you sure you want to delete <strong>@Model.Title</strong>?
                This action cannot be undone.
            </div>

            <form asp-area="Admin" asp-controller="BookManagement" asp-action="Delete"
                  asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()

                <div class="d-flex gap-2 mt-3">
                    <button type="submit" class="btn btn-danger fw-bold">
                        <i class="bi bi-trash-fill me-1"></i> Confirm Delete
                    </button>
                    <a asp-area="Admin" asp-controller="BookManagement" asp-action="Manage"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
