@using OnlineLibrary.Services.Models.Author
@model IEnumerable<AuthorsAllDto>

@{
    ViewData["Title"] = "Manage Authors";
}

<div class="container mt-4">
    <h1 class="text-center text-warning fw-bold">Manage Authors</h1>
    <p class="text-center text-muted">View, edit, or delete author entries.</p>

    <div class="d-flex justify-content-between mb-3">
        <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="btn btn-secondary fw-bold">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
        <a asp-area="Admin" asp-controller="AuthorManagement" asp-action="Add" class="btn btn-success fw-bold shadow-lg">
            <i class="bi bi-plus-circle"></i> Add New Author
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center" role="alert">
            <i class="bi bi-exclamation-circle"></i> No authors found. Click "Add New Author" to create one.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover shadow-lg rounded-3">
                <thead>
                    <tr class="text-warning text-center">
                        <th scope="col">Full Name</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var author in Model)
                    {
                        <tr class="align-middle text-center">
                            <td class="fw-bold">@author.FullName</td>
                            <td>
                                <a asp-area="Admin" asp-controller="AuthorManagement" asp-action="Edit" asp-route-id="@author.Id"
                                   class="btn btn-sm btn-warning me-1">
                                    <i class="bi bi-pencil-fill"></i> Edit
                                </a>
                                <a asp-area="Admin" asp-controller="AuthorManagement" asp-action="Delete" asp-route-id="@author.Id"
                                   class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash-fill"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
