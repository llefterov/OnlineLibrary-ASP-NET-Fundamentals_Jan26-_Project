@using OnlineLibrary.Web.ViewModels.Publisher
@model PublisherEditViewModel

@{
    ViewData["Title"] = "Edit Publisher";
}

<div class="container py-4">
    <div class="card shadow-lg border-0 bg-dark text-white rounded-3 mx-auto" style="max-width:720px;">
        <div class="card-body p-4">
            <h2 class="card-title text-warning fw-bold mb-3">@ViewData["Title"]</h2>

            <form asp-area="Admin" asp-controller="PublisherManagement" asp-action="Edit" method="post"
                  class="needs-validation" novalidate="novalidate">
                @Html.AntiForgeryToken()
                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label text-light"></label>
                    <input asp-for="Name" class="form-control bg-secondary text-white border-0" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-warning fw-bold">
                        <i class="bi bi-pencil-fill me-1"></i> Save Changes
                    </button>
                    <a asp-area="Admin" asp-controller="PublisherManagement" asp-action="Manage"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Manage
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
