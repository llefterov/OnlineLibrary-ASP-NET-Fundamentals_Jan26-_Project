@using OnlineLibrary.Web.ViewModels.Publisher
@model PublisherDeleteViewModel

@{
    ViewData["Title"] = "Delete Publisher";
}

<div class="container py-4">
    <div class="card shadow-lg border-0 bg-dark text-white rounded-3 mx-auto" style="max-width:800px;">
        <div class="card-body p-4">
            <h2 class="card-title text-danger fw-bold mb-3">@ViewData["Title"]</h2>

            <p class="text-light">Are you sure you want to delete the following publisher?</p>

            <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

            <dl class="row text-light">
                <dt class="col-sm-3">Name</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Id</dt>
                <dd class="col-sm-9 text-warning small">@Model.Id</dd>
            </dl>

            @if (Model.Books != null && Model.Books.Any())
            {
                <h5 class="mt-3 text-warning">Associated Books</h5>
                <ul class="list-group list-group-flush mb-3">
                    @foreach (var book in Model.Books.OrderBy(b => b.Title))
                    {
                        <li class="list-group-item bg-secondary text-white d-flex justify-content-between">
                            <span>@book.Title</span>
                            <small class="text-muted">@book.DateAdded.ToString("yyyy-MM-dd")</small>
                        </li>
                    }
                </ul>
            }

            <form asp-area="Admin" asp-controller="PublisherManagement" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-danger fw-bold">
                        <i class="bi bi-trash-fill me-1"></i> Confirm Delete
                    </button>
                    <a asp-area="Admin" asp-controller="PublisherManagement" asp-action="Manage"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Manage
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
